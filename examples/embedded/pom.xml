<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.streamlit4j</groupId>
    <artifactId>streamlit4j-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>streamlit4j-examples-embedded</artifactId>
  <name>streamlit4j examples (embedded server)</name>
  <description>Standalone demos launched via their own main() against the embedded Streamlit4jServer (Jetty).</description>

  <properties>
    <!-- example projects are not published to Maven Central -->
    <maven.deploy.skip>true</maven.deploy.skip>
    <central-publishing.skip>true</central-publishing.skip>
    <!-- Default mainClass; override with -Dexec.mainClass=... at the CLI. -->
    <exec.mainClass>io.streamlit4j.examples.ShowcaseDemo</exec.mainClass>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.streamlit4j</groupId>
      <artifactId>streamlit4j-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.streamlit4j</groupId>
      <artifactId>streamlit4j-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <scope>runtime</scope>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <!-- Default to the sidebar-driven hub; override via -Dexec.mainClass=... -->
          <mainClass>${exec.mainClass}</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
