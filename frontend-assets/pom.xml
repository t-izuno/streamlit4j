<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.streamlit4j</groupId>
    <artifactId>streamlit4j-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>streamlit4j-frontend-assets</artifactId>
  <name>streamlit4j frontend assets</name>
  <description>Pre-built frontend SPA bundled as classpath resources under META-INF/resources/streamlit4j/.</description>

  <properties>
    <maven.javadoc.skip>true</maven.javadoc.skip>
    <frontend.dist.dir>${project.basedir}/../frontend/dist</frontend.dist.dir>
  </properties>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-frontend-spa</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <copy todir="${project.build.outputDirectory}/META-INF/resources/streamlit4j"
                      overwrite="true" failonerror="false">
                  <fileset dir="${frontend.dist.dir}" erroronmissingdir="false">
                    <include name="**/*"/>
                  </fileset>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
